# ==========================================
# MediFind Backend - .gitignore
# ==========================================

# Compiled class files
*.class

# Log files
*.log
logs/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Maven target directory
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE & Editor files
.idea/
*.iml
.classpath
.project
.settings/
.vscode/

# Private File Uploads & Local runtime data
private-uploads/
uploads/

# Environment files
.env
.env.*
!.env.example
