# Copy these into the environment used to start the Spring Boot backend.
DB_URL=jdbc:mysql://localhost:3306/medifind?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=your_mysql_username
DB_PASSWORD=replace_with_your_mysql_password
JWT_SECRET=replace_with_base64_encoded_random_32_byte_key
SEED_DEMO_USERS=false
DEMO_ADMIN_PASSWORD=
DEMO_PHARMACY_PASSWORD=
DEMO_USER_PASSWORD=
